# Copy to .env and set real values. Never commit .env.
SS_ENV=development              # development | staging
SS_SECRET_KEY=change-me-long-random   # required outside development
SS_DATABASE_URL=sqlite:///./data/scamshield.db   # staging: postgresql+psycopg://user:pass@host/db
SS_STORAGE_DIR=./data/evidence  # outside the web root
SS_COOKIE_SECURE=false          # must be true behind TLS in staging
SS_VERIFY_MIN_INDEPENDENT=3
SS_VERIFY_ALLOW_MOD_EVIDENCE=true
SS_CORRECTION_SLA_DAYS=7
SS_API_RATE_PER_MINUTE=60
SS_REPORT_RATE_PER_HOUR=10
SS_MAX_UPLOAD_BYTES=5242880
SS_COUNTY_SUPPRESSION=5
SS_LLM_ENABLED=false
